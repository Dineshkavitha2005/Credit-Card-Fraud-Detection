# ==============================================================================
# Credit Card Fraud Detection System - Environment Configuration Template
# Copy this file to .env and configure variables before running.
# Production strictly requires PostgreSQL; SQLite is permitted only for dev/testing.
# ==============================================================================

# Application Environment (production / development / testing)
FLASK_ENV=

# Server Port
PORT=

# Security Secret Key for session signing and CSRF protection (Required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet 32-byte Base64 Encryption Key for Cardholder Data Protection (Required)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARD_ENCRYPTION_KEY=

# Optional dedicated secrets for development / test environments
DEV_SECRET_KEY=
TEST_SECRET_KEY=

# PostgreSQL Database Service Configuration (Required for Production)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Database Connection URI (Required for Production, e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=

# WSGI Concurrency Settings
WORKERS=
THREADS=
TIMEOUT=
LOG_LEVEL=

# SMTP Email Alert Notification Settings (Optional)
SMTP_SERVER=
SMTP_PORT=
SENDER_EMAIL=
SENDER_PASSWORD=

# Google OAuth 2.0 / OpenID Connect Client Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_DOMAIN=

